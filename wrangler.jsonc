{
  // Cloudflare Workers Static Assets — serves the Expo web export (dist/) as a
  // static SPA. Cloudflare Builds runs `npm run build:web` (produces dist/), then
  // `npx wrangler deploy`, which uploads ./dist as static assets. No Worker script
  // is needed (assets-only). dist/_headers (COOP/COEP) is honored, so wa-sqlite can
  // cross-origin isolate on the deployed site.
  "name": "ttrp-helper",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
